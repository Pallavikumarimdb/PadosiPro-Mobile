generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  mobile          String       @unique
  emailVerified   Boolean      @default(false)
  profileComplete Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  otps            OtpCode[]
  profile         UserProfile?
  requests        ServiceRequest[]
  household       HouseholdMember[]

  @@index([email])
  @@index([mobile])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  mobile       String
  address      String
  city         String   @default("Mumbai")
  society      String?
  flatUnit     String?
  gateNotes    String?
  businessName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  title       String   @unique
  description String
  icon        String
  comingSoon  Boolean  @default(false)
  kinds          String[] @default([])
  servicesByKind Json     @default("{}")
  createdAt   DateTime @default(now())
}

model ServiceRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  service   String?
  helpKind  String?
  urgency   String?
  details   String?
  status    String   @default("submitted")
  createdAt DateTime @default(now())

  @@index([userId])
}

model HouseholdMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  relation  String
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId])
}
