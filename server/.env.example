DATABASE_URL="postgresql://padosi:padosi@localhost:5432/padosipro?schema=public"
JWT_SECRET="dev-only-change-me-min-32-chars"
PORT=3000
NODE_ENV="development"
OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Email: set SMTP_HOST to send real OTP mail (local Mailpit via docker
# compose: SMTP_HOST=localhost SMTP_PORT=1025, inbox at http://localhost:8025).
# Leave SMTP_HOST empty to log OTPs to the backend console instead.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PadosiPro <otp@padosipro.local>"
